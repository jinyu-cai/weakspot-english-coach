# Copy to apps/api/.env on the production server and replace placeholders.
APP_ENV=production
APP_NAME=WeakSpot English Coach API

# Default OpenAI-compatible provider. Generic names are preferred for new
# deployments; DEEPSEEK_* is still supported for backwards compatibility.
# OPENAI_COMPAT_API_KEY=sk-REPLACE_ME
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODEL=your_chat_model
# OPENAI_COMPAT_FAST_MODEL=your_fast_chat_model

# OpenRouter supplies the Luna Pro/Luna fallback pair after the shared official
# Luna quota is exhausted. Routing stays pinned to OpenRouter's OpenAI endpoint.
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna-pro
OPENROUTER_FAST_MODEL=openai/gpt-5.6-luna

# OpenCode Go supplies a selectable DeepSeek V4 Pro/Flash pair through its
# OpenAI-compatible API. When both keys are configured, the default remains the
# quota-routed OpenRouter Luna Pro/Luna pair.
# OPENCODE_GO_API_KEY=REPLACE_ME
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DEEPSEEK_MODEL=deepseek-v4-pro
OPENCODE_GO_DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Alibaba Cloud Model Studio Qwen 3.7 profile. When QWEN_MODEL_STUDIO_API_KEY
# is set without OPENROUTER_API_KEY or OPENCODE_GO_API_KEY, it takes precedence
# over OPENAI_COMPAT_* and DEEPSEEK_* for the server default. If multiple
# providers have keys, the UI safely offers each server-managed choice.
# QWEN_MODEL_STUDIO_API_KEY=REPLACE_ME
# QWEN_MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_STUDIO_MODEL=qwen3.7-max
# QWEN_MODEL_STUDIO_FAST_MODEL=qwen3.7-plus

# Private Ollama Hunyuan MT2 ebook translation fallback. The production host
# must be connected to the same Tailnet before enabling this profile.
# LOCAL_QWEN_API_KEY=ollama
# LOCAL_QWEN_BASE_URL=https://your-tailnet-host:8443/v1
# LOCAL_QWEN_MODEL=hy-mt2:7b
# Coach listening reuses QWEN_MODEL_STUDIO_API_KEY or QWEN_EMBEDDING_API_KEY
# unless this is set.
# QWEN_TTS_API_KEY=REPLACE_ME
# QWEN_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# QWEN_TTS_MODEL=qwen3-tts-flash
# QWEN_TTS_VOICE=Cherry
# QWEN_TTS_LANGUAGE=English
# Set an embedding-only key when the deployment should retain a different text
# provider. If omitted, embeddings reuse QWEN_MODEL_STUDIO_API_KEY.
# QWEN_EMBEDDING_API_KEY=REPLACE_ME
# QWEN_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_EMBEDDING_MODEL=text-embedding-v4
# QWEN_EMBEDDING_DIMENSIONS=256

# Legacy official DeepSeek fallback for deployments without OpenCode Go.
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_FAST=ds-v4-flash-0731

# OpenAI Realtime voice. Keep this only on the backend server.
OPENAI_API_KEY=<openai-api-key>
# Official Luna primary. If the dedicated key is omitted, OPENAI_API_KEY is
# reused. Deep/Fast fall back to OpenRouter; ebook translation falls back to HY.
# OPENAI_TRANSLATION_API_KEY=<openai-api-key>
OPENAI_TRANSLATION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna
OPENAI_TRANSLATION_TIMEOUT_SECONDS=45
OPENAI_LUNA_DAILY_TOKEN_LIMIT=2500000
OPENAI_SOL_DAILY_TOKEN_LIMIT=250000
OPENAI_QUOTA_TIMEZONE=America/Los_Angeles
OPENAI_QUOTA_RESET_HOUR=5
# Enable this only after the deployed key has GPT-5.6 access. The API refuses
# non-GPT-5.6 model IDs on this path so the demo cannot mislabel another model.
OPENAI_BUILD_WEEK_ENABLED=false
# OPENAI_BUILD_WEEK_API_KEY=<openai-api-key>
OPENAI_BUILD_WEEK_BASE_URL=https://api.openai.com/v1
OPENAI_BUILD_WEEK_MODEL=gpt-5.6-sol
OPENAI_BUILD_WEEK_REASONING_EFFORT=medium
OPENAI_BUILD_WEEK_TIMEOUT_SECONDS=180
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15
OPENAI_REALTIME_MODELS=gpt-realtime-mini-2025-12-15,gpt-realtime-2

# Amazon RDS for PostgreSQL. Replace the host, user, and URL-encoded password.
# The CA path is mounted read-only by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://weakspot_app:REPLACE_ME@REPLACE_RDS_ENDPOINT:5432/weakspot?sslmode=verify-full&sslrootcert=/run/secrets/rds-ca-bundle.pem
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Comma-separated list of exact frontend origins.
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
DEMO_USER_ID=demo-user-001

# Private ebook import. Raw uploads have no application-level size cap; keep
# the expanded EPUB safety limit to reject decompression bombs.
EBOOK_IMPORT_ENABLED=true
EBOOK_MAX_EXPANDED_MB=100
EBOOK_MAX_PAGES=5000
EBOOK_LOGICAL_PAGE_WORDS=300

# MemoryAgent
MEMORY_ENABLED=true
MEMORY_CONTEXT_TOKEN_BUDGET=700
MEMORY_CONTEXT_TOKEN_SAFETY_RATIO=0.85
MEMORY_RETRIEVAL_LIMIT=6
MEMORY_MAX_ITEMS_PER_USER=200
MEMORY_CHAT_RECENT_MESSAGES=12

# Auth (GitHub OAuth) + rate limiting
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
OAUTH_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/github/callback
FRONTEND_URL=https://your-vercel-app.vercel.app
COOKIE_DOMAIN=.your-domain.com
OWNER_GITHUB_LOGINS=your-github-login,test-github-login
# OWNER_BYPASS_TOKEN=
GUEST_DAILY_LIMIT=3
USER_DAILY_LIMIT=20

# Production: keep local testing settings unset.
# USE_FAKE_AI=false
